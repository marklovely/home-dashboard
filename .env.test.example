# Test/staging frontend — copy to .env.local when exercising the isolated test stack.
# Restart `npm run dev` after changing.
#
# Option A: call test Worker directly (requires CORS / no Access on workers.dev for dev)
VITE_API_BASE_URL=https://lovely-home-hub-api-test.your-subdomain.workers.dev

# Option B: use test Pages proxy (same-origin /api) — build or open test Pages URL instead.
# VITE_API_BASE_URL is optional on Pages; production builds use /api on the Pages host.

VITE_DEPLOYMENT_MODE=home

# Shows the TEST banner in the UI (also auto-detected on test.lovely-home.co.uk).
VITE_HUB_ENVIRONMENT=test
