# Frontend environment (copy to .env.local at the **repo root** — gitignored)
# Vite reads this file from the project root (see vite.config.js envDir).
# Restart `npm run dev` after changing. For Cloudflare Pages, set the same variables
# under Settings → Environment variables and redeploy (build embeds it + runtime-config.json).
#
# Local dev: point at wrangler (direct Worker URL).
VITE_API_BASE_URL=https://lovely-home-hub-api.your-subdomain.workers.dev
#
# Optional — same-origin /api proxy on Pages (only after HUB_API binding + dual CF_ACCESS_AUD):
# VITE_USE_PAGES_API_PROXY=true
# VITE_API_BASE_URL=   (unset)
# WORKER_API_ORIGIN=https://lovely-home-hub-api.your-subdomain.workers.dev
#
# Default (stable): keep VITE_API_BASE_URL pointing at the Worker for Preview and Production.

# Deployment: "home" (switch owner ⇄ house sitter at runtime) or "house-sitter" (guest-only build).
# VITE_DEPLOYMENT_MODE=home

# Owner PIN is NOT configured here — set Worker secret OWNER_PIN (see docs/architecture.md).
