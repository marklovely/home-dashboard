{
  "name": "home-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/write-runtime-config.js && vite build && node scripts/copy-pwa-assets.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test && npm run build && node scripts/check-dist-secrets.js && npm run check --prefix worker",
    "guide:extract": "python3 scripts/extract_house_guide.py",
    "guide:build-catalog": ".venv-guide/bin/python scripts/build_house_guide_catalog.py",
    "guide:check": "vitest run tests/guideCatalog.test.js tests/guideMedia.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-cloudflare-access": "^1.0.5",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "dompurify": "^3.4.12",
    "emoji-picker-element": "^1.29.1",
    "lucide": "^1.27.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4"
  }
}
