{
  "name": "home-dashboard",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "node scripts/write-runtime-config.js && vite --host 0.0.0.0",
    "build": "node scripts/write-runtime-config.js && vite build && node scripts/copy-pwa-assets.js",
    "build:platform": "node scripts/build-platform-manifest.mjs && vite build --config vite.platform.config.js",
    "dev:platform": "node scripts/dev-platform-admin.mjs",
    "platform:manifest": "node scripts/build-platform-manifest.mjs",
    "build:website-qr": "node scripts/build-website-qr.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test && npm run build && node scripts/check-dist-secrets.js && npm run check --prefix worker",
    "guide:extract": "python3 scripts/extract_house_guide.py",
    "guide:build-catalog": ".venv-guide/bin/python scripts/build_house_guide_catalog.py",
    "guide:check": "vitest run tests/guideCatalog.test.js tests/guideMedia.test.js",
    "d1:migrate:all": "node scripts/apply-d1-migrations-all.mjs",
    "deploy:all": "node scripts/deploy-all-workers.mjs",
    "sync:archive-secret": "node scripts/sync-platform-site-archive-secret.mjs",
    "sync:production-access": "node scripts/sync-wrangler-production-access.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-cloudflare-access": "^1.0.5",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "dompurify": "^3.4.12",
    "emoji-picker-element": "^1.29.1",
    "lucide": "^1.27.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4"
  }
}
