{
  "name": "lovely-home-hub-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:test": "node scripts/check-test-provisioned.mjs && wrangler deploy --env test",
    "provision:test": "bash ../scripts/provision-cloudflare-test.sh",
    "d1:migrate:prod": "wrangler d1 migrations apply lovely-home-appliance-manuals --remote",
    "d1:migrate:test": "node scripts/check-test-provisioned.mjs && wrangler d1 migrations apply lovely-home-appliance-manuals-test --remote --env test",
    "secrets:test": "bash scripts/print-test-secrets-checklist.sh",
    "test": "vitest run",
    "check": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "jose": "^5.10.0"
  }
}
