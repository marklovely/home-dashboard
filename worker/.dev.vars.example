# Copy to worker/.dev.vars (gitignored) for local wrangler dev.
VIRTUAL_BUTTONS_ACCESS_CODE=replace-with-your-code
PRIVATE_WIFI_SSID=ExampleNetwork
PRIVATE_WIFI_PASSWORD=example-password
PRIVATE_MARK_PHONE=00000000000
PRIVATE_MARK_EMAIL=mark.example@example.com
PRIVATE_DONNA_PHONE=00000000000
PRIVATE_DONNA_EMAIL=donna.example@example.com
PRIVATE_HOME_ADDRESS=Example Street, Example Town
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Add OWNER_PIN to worker/.dev.vars for local owner-auth testing (never commit the real value).
# Optional for My Day local testing (never commit real URLs):
# OWNER_SESSION_SECRET=local-dev-signing-secret
# APPLE_CALENDAR_ICS_URL=https://example.invalid/test.ics
