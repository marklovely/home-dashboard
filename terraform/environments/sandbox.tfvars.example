# Copy to terraform/environments/sandbox.tfvars and fill in (never commit real values).
# For sandbox + test together, see environments/hub.tfvars.example.
# Apply sandbox only: terraform apply -var-file=environments/sandbox.tfvars

cloudflare_account_id = "YOUR_ACCOUNT_ID"
cloudflare_zone_id    = "YOUR_ZONE_ID"
workers_subdomain     = "mark-lovely67"
access_team_domain    = "lovely-home"
zone_name             = "lovely-home.co.uk"

owner_emails = [
  "owner@example.com", # real emails — placeholders overwrite Access policies on apply
]

sitter_emails = [
  # "sitter@example.com",
]

sites = {
  sandbox = {
    hostname               = "sandbox.lovely-home.co.uk"
    hub_environment        = "sandbox"
    vanilla                = true
    terraform              = true
    attach_hub_api_binding = false # first apply only; set true after Worker deploy + second apply
  }
}
