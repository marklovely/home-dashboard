# Combined hub sites — copy to terraform/environments/hub.tfvars (never commit).
# Use for terraform apply / import across sandbox + test.
#
# Always pass -var=terraform_stack=platform or customers, and init the matching
# R2 backend key (platform.tfstate vs customers/{siteId}.tfstate). Customer applies
# also need -var=provision_site_id=<siteId>. Defaulting to platform against a
# customers backend (or the legacy hub.tfstate) can destroy the other estate.

cloudflare_account_id = "YOUR_ACCOUNT_ID"
cloudflare_zone_id    = "YOUR_ZONE_ID" # lovely-home.co.uk — platform + internal hubs
workers_subdomain     = "mark-lovely67"
access_team_domain    = "lovely-home"
zone_name             = "lovely-home.co.uk"

# Customer household hubs live on a separate zone (register lovely-hub.com in Cloudflare first).
# Required when any site in `sites` has zone_name = "lovely-hub.com".
# customer_cloudflare_zone_id = "YOUR_LOVELY_HUB_COM_ZONE_ID"
# customer_zone_name          = "lovely-hub.com"

owner_emails = [
  "owner@example.com", # household owners — Access on every hub (production, test, sandbox, …)
]

sitter_emails = [] # optional — house sitters on every hub unless a site overrides sitter_emails

platform_operator_emails = [
  "you@example.com", # Mark-only — not household owner_emails
]

# Optional — enables platform admin site wizard (GitHub Actions PR automation)
# platform_github_token = "ghp_..."

# Optional — D1/R2 usage, PR preview toggles, and marketing-site OTP guest list
# platform_cf_api_token = "..." # Account Read, D1 Read, R2 Read, Pages Edit, Access: Apps and Policies Edit

# Stripe billing on platform admin (required if billing enabled — terraform apply wipes dashboard-only vars)
# stripe_secret_key     = "sk_test_..."
# stripe_webhook_secret = "whsec_..."
# stripe_price_id         = "price_..."  # £9.99/month (test)
# stripe_price_id_yearly  = "price_..."  # £99/year (test)
# Live keys — optional until public launch. Mode is switched from platform admin, not Terraform.
# stripe_secret_key_live     = "sk_live_..."
# stripe_webhook_secret_live = "whsec_..."
# stripe_price_id_live         = "price_..."
# stripe_price_id_yearly_live  = "price_..."

# Public trial signup on lovely-home.co.uk (Slice 3 — requires Stripe + platform_github_token above)
# marketing_site_origin  = "https://lovely-home.co.uk"
# public_signup_enabled  = true

# Bot check on the signup form. Both values must be set before the challenge is enforced.
# turnstile_site_key    = "0x4AAA..."
# turnstile_secret_key  = "0x4AAA..."

# Customer emails (Resend). Verify support@lovely-home.co.uk (or your from-address) on the domain.
# resend_api_key       = "re_..."
# customer_email_from  = "Lovely Home <support@lovely-home.co.uk>"

# Pre-launch: OTP-gate lovely-home.co.uk. Operators come from platform_operator_emails.
# Extra preview emails: platform dashboard → Marketing site access (not this list).
# Set false at public launch.
# marketing_site_access_protected = true

# Preview builds for non-main branches (platform admin + Terraform-managed hub Pages). Default true.
# pages_preview_deployments_enabled = true

platform_admin = {
  enabled    = true
  hostname   = "platform.lovely-home.co.uk"
  pages_name = "home-dashboard-platform"
}

sites = {
  production = {
    hostname         = "dashboard.lovely-home.co.uk"
    hub_environment  = "production"
    vanilla          = false
    terraform        = true
    hub_proxy_secret = "PASTE_EXISTING_HUB_PROXY_SECRET"
  }

  sandbox = {
    hostname        = "sandbox.lovely-home.co.uk"
    hub_environment = "sandbox"
    vanilla         = true
    terraform       = true
    tester_emails = [
      "trial-user@example.com", # sandbox/test only — not production
    ]
  }

  test = {
    hostname         = "test.lovely-home.co.uk"
    hub_environment  = "test"
    vanilla          = true
    terraform        = true
    hub_proxy_secret = "PASTE_EXISTING_HUB_PROXY_SECRET"
    tester_emails = [
      "trial-user@example.com",
    ]
  }






  demo = {
    hostname               = "demo.lovely-home.co.uk"
    hub_environment        = "demo"
    vanilla                = true
    terraform              = true
    access_enabled         = false
    attach_hub_api_binding = false # first apply only; set true after Worker deploy
  }

  dev = {
    hostname               = "dev.lovely-home.co.uk"
    hub_environment        = "dev"
    vanilla                = true
    terraform              = true
    attach_hub_api_binding = false # first apply only; set true after Worker deploy
  }

  # Example customer hub (uncomment after customer_cloudflare_zone_id is set):
  # smith = {
  #   hostname        = "smith.lovely-hub.com"
  #   zone_name       = "lovely-hub.com"
  #   hub_environment = "smith"
  #   vanilla         = false
  #   terraform       = true
  #   owner_emails = [
  #     "smith@example.com",
  #   ]
  # }

  smith = {
    hostname        = "smith.lovely-hub.com"
    hub_environment = "smith"
    vanilla         = false
    terraform       = true
    zone_name       = "lovely-hub.com"
    attach_hub_api_binding = false # first apply only; set true after Worker deploy
    owner_emails = ["marklovely67@gmail.com"]
  }















  wagtail = {
    hostname        = "wagtail.lovely-hub.com"
    hub_environment = "wagtail"
    vanilla         = false
    terraform       = true
    zone_name       = "lovely-hub.com"
    attach_hub_api_binding = false # first apply only; set true after Worker deploy
  }











  e2e-nqnrfvy8 = {
    hostname        = "e2e-nqnrfvy8.lovely-hub.com"
    hub_environment = "e2e-nqnrfvy8"
    vanilla         = false
    terraform       = true
    zone_name       = "lovely-hub.com"
    attach_hub_api_binding = false # first apply only; set true after Worker deploy
  }

  e2e-dy940psa = {
    hostname        = "e2e-dy940psa.lovely-hub.com"
    hub_environment = "e2e-dy940psa"
    vanilla         = false
    terraform       = true
    zone_name       = "lovely-hub.com"
    attach_hub_api_binding = false # first apply only; set true after Worker deploy
  }

  e2e-cr5648bt = {
    hostname        = "e2e-cr5648bt.lovely-hub.com"
    hub_environment = "e2e-cr5648bt"
    vanilla         = false
    terraform       = true
    zone_name       = "lovely-hub.com"
    attach_hub_api_binding = false # first apply only; set true after Worker deploy
  }

}
