# Combined hub sites — copy to terraform/environments/hub.tfvars (never commit).
# Use for terraform apply / import across sandbox + test.

cloudflare_account_id = "YOUR_ACCOUNT_ID"
cloudflare_zone_id    = "YOUR_ZONE_ID"
workers_subdomain     = "mark-lovely67"
access_team_domain    = "lovely-home"
zone_name             = "lovely-home.co.uk"

owner_emails = [
  "owner@example.com", # real owner emails — placeholders overwrite Access on apply
]

sitter_emails = []

platform_operator_emails = [
  "you@example.com", # Mark-only — not household owner_emails
]

# Optional — enables platform admin site wizard (GitHub Actions PR automation)
# platform_github_token = "ghp_..."

platform_admin = {
  enabled    = true
  hostname   = "platform.lovely-home.co.uk"
  pages_name = "home-dashboard-platform"
}

sites = {
  production = {
    hostname         = "dashboard.lovely-home.co.uk"
    hub_environment  = "production"
    vanilla          = false
    terraform        = true
    hub_proxy_secret = "PASTE_EXISTING_HUB_PROXY_SECRET"
  }

  sandbox = {
    hostname        = "sandbox.lovely-home.co.uk"
    hub_environment = "sandbox"
    vanilla         = true
    terraform       = true
  }

  test = {
    hostname         = "test.lovely-home.co.uk"
    hub_environment  = "test"
    vanilla          = true
    terraform        = true
    hub_proxy_secret = "PASTE_EXISTING_HUB_PROXY_SECRET"
  }


  demo = {
    hostname        = "demo.lovely-home.co.uk"
    hub_environment = "demo"
    vanilla         = true
    terraform       = true
    attach_hub_api_binding = false # first apply only; set true after Worker deploy
  }

}
