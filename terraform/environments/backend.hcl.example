# Terraform remote state — Cloudflare R2
#
# SETUP (one time):
#   1. Create R2 bucket in Cloudflare dashboard (e.g. lovely-home-terraform-state)
#   2. Create R2 API token with Object Read & Write on that bucket
#   3. cp this file to backend.hcl and fill in bucket + endpoint below
#   4. export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the R2 token
#   5. cd terraform && terraform init -backend-config=environments/backend.hcl
#      (answer yes when asked to copy local state — that is the migration)
#
# See docs/platform-provision.md for the full walkthrough.
#
# backend.hcl is gitignored — never commit it or the R2 token.

bucket                      = "YOUR_R2_BUCKET_NAME"
key                         = "home-dashboard/hub.tfstate"
region                      = "auto"
endpoints = {
  s3 = "https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
}
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
use_path_style              = true
